{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chass-keiba-lab7",
  "main": "worker-entry.mjs",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "vars": {
    "ENABLE_JRA_MEETING_DISCOVERY": "true",
    "ENABLE_JRA_AUTO_FETCH": "false",
    "ENABLE_JRA_ODDS_FETCH": "true",
    "ENABLE_JRA_RESULT_FETCH": "true",
    "ENABLE_JRA_BACKGROUND_REFRESH": "false",
    "ENABLE_JRA_DIRECT_FETCH": "false",
    "ENABLE_JRA_ODDS_DIRECT_FETCH": "false",
    "ENABLE_NAR_PREFETCH": "true",
    "ENABLE_NAR_ABILITY_PRECOMPUTE": "true",
    "ENABLE_NAR_ABILITY_VIEWER": "true",
    "ENABLE_NAR_HISTORY_LINKS": "true",
    "NAR_PRECOMPUTE_TRACK_CODES": "21",
    "NAR_PRECOMPUTE_MAX_JOBS": "3",
    "NAR_PRECOMPUTE_BUDGET_MS": "20000",
    "NAR_PRECOMPUTE_RUN_MODE": "daily",
    "NAR_PRECOMPUTE_DAILY_FROM": "2026-10-14",
    "NAR_PRECOMPUTE_DAILY_UNTIL": "2026-10-20",
    "NAR_PRECOMPUTE_DAILY_START_JST": "07:00",
    "NAR_PRECOMPUTE_DAILY_STOP_JST": "14:55",
    "ENABLE_FAVORITE_RISK_SNAPSHOTS": "true",
    "ENABLE_BACKGROUND_PRECOMPUTE": "true",
    "ENABLE_JRA_PRECOMPUTED_MARKET_BRIDGE": "true",
    "ENABLE_PRECOMPUTED_VIEWER": "true",
"JRA_PRECOMPUTE_CALCULATION_VERSION": "jra-ability-data-v2",
"JRA_PRECOMPUTE_MODEL_VERSION": "10.0.1-jra-drive1-ability",
"JRA_PRECOMPUTE_SOURCE_MODE": "official-cache",
"JRA_PRECOMPUTE_MAX_PLANNING_JOBS": "4",
"JRA_PRECOMPUTE_MAX_JOBS": "1",
"JRA_PRECOMPUTE_PLANNING_WINDOW_MS": "2000",
"JRA_PRECOMPUTE_TOTAL_WINDOW_MS": "8000",
    "CHASS_PUBLIC_ORIGIN": "https://chass-keiba-lab7.h7625421.workers.dev"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chass-keiba-research-db",
      "database_id": "ea63ed0d-7644-43aa-98f1-684a38dec32f"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 11 * * *",
      "30 11 * * *"
    ]
  }
}
