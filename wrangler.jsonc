{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chass-keiba-lab7",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chass-keiba-research-db",
      "database_id": "ea63ed0d-7644-43aa-98f1-684a38dec32f"
    }
  ],
  "observability": {
    "enabled": true
  }
}
