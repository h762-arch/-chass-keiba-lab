{
  "openapi": "3.1.0",
  "info": {
    "title": "CHASS AI Data Bridge",
    "version": "1.0.0",
    "description": "Read-only access to saved CHASS prediction, result and research data. This API never fetches NAR or writes D1."
  },
  "servers": [{"url": "/api/chass/v1"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/health": {"get": {"summary": "Check bridge and database connectivity", "responses": {"200": {"description": "Connected"}, "401": {"description": "Unauthorized"}}}},
    "/context": {"get": {"summary": "Get latest, recent, pending, race or research context", "parameters": [{"name":"scope","in":"query","schema":{"type":"string","enum":["latest","race","recent","pending","research"]}},{"name":"raceId","in":"query","schema":{"type":"string"}},{"name":"date","in":"query","schema":{"type":"string","format":"date"}},{"name":"track","in":"query","schema":{"type":"string"}},{"name":"raceNo","in":"query","schema":{"type":"integer"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100}},{"name":"cursor","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Read-only CHASS context"},"401":{"description":"Unauthorized"},"404":{"description":"Race not found"},"429":{"description":"Rate limited"},"503":{"description":"Database unavailable"}}}},
    "/race": {"get": {"summary": "Get race prediction and validation", "parameters":[{"name":"raceId","in":"query","schema":{"type":"string"}},{"name":"date","in":"query","schema":{"type":"string","format":"date"}},{"name":"track","in":"query","schema":{"type":"string"}},{"name":"raceNo","in":"query","schema":{"type":"integer"}}],"responses": {"200":{"description":"One race"},"401":{"description":"Unauthorized"},"404":{"description":"Race not found"},"503":{"description":"Database unavailable"}}}},
    "/research": {"get": {"summary": "Get research metrics", "responses": {"200":{"description":"Aggregated research metrics"},"401":{"description":"Unauthorized"},"503":{"description":"Database unavailable"}}}},
    "/pending": {"get": {"summary": "Get pending results", "parameters":[{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100}},{"name":"cursor","in":"query","schema":{"type":"string"}}],"responses": {"200":{"description":"Pending result queue"},"401":{"description":"Unauthorized"},"503":{"description":"Database unavailable"}}}}
  },
  "components": {"securitySchemes": {"bearerAuth": {"type":"http","scheme":"bearer","bearerFormat":"opaque secret"}}}
}
