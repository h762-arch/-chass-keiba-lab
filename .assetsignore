# CHASS public static-asset security boundary
.assetsignore
.git
.git/**
.github
.github/**
.wrangler
.wrangler/**
node_modules
node_modules/**
tests
tests/**
migrations
migrations/**
mcp
mcp/**
scripts
scripts/**

# Server/runtime internals
worker.js
server.mjs
*.mjs
# Exact browser module exceptions; keep all other server/research modules excluded.
!/src/prediction/jra-browser-bootstrap.mjs
!/src/prediction/jra-ability-core.mjs
!/src/prediction/jra-ability-result-projector.mjs
!/src/prediction/course-asset-core-v1.mjs
!/src/prediction/course-shadow-preflight-v1.mjs
!/src/prediction/course-asset-web-adapter-v1.mjs
!/src/prediction/chass-cpsi-wave-core-v1.mjs
!/src/prediction/cpsi-source-recovery-v1.mjs
!/src/prediction/early-kpi-dashboard-boundary-v1.mjs
wrangler.jsonc
wrangler.*.jsonc
package.json
package-lock.json
d1-schema.sql
*.sql

# Internal reports / patch notes / checksums
*.md
*.txt
JRA_*_SHA256.json

!/src/prediction/wave-analysis-v1.mjs
!/src/prediction/wave-analysis-ui-v1.mjs
